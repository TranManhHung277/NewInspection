<UserControl x:Class="NAutoSuite.UI.Controls.ShellFooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="100">
    <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <UniformGrid Rows="1" Columns="5" >
                <!-- Auto Tab -->
                <Border x:Name="AutoTab" Background="#1E1E1E" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand" 
                        MouseLeftButtonDown="Tab_Click" Tag="Auto">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="▶" FontSize="36" Foreground="#2196F3"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="AUTO" FontSize="36" Foreground="White" FontWeight="Bold" Margin="10,0,10,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Manual Tab -->
                <Border x:Name="ManualTab" Background="Transparent" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand" 
                        MouseLeftButtonDown="Tab_Click" Tag="Manual">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="🎮" FontSize="36" Foreground="#B0B0B0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="MANUAL" FontSize="36" Foreground="#B0B0B0" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    </StackPanel>
                </Border>

                <!-- Data Tab -->
                <Border x:Name="DataTab" Background="Transparent" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand" 
                        MouseLeftButtonDown="Tab_Click" Tag="Data">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="36" Foreground="#B0B0B0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="DATA" FontSize="36" Foreground="#B0B0B0" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    </StackPanel>
                </Border>

                <!-- Setting Tab -->
                <Border x:Name="SettingTab" Background="Transparent" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand" 
                        MouseLeftButtonDown="Tab_Click" Tag="Setting">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="36" Foreground="#B0B0B0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="SETTING" FontSize="36" Foreground="#B0B0B0" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    </StackPanel>
                </Border>

                <!-- Log Tab -->
                <Border x:Name="LogTab" Background="Transparent" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand"
                        MouseLeftButtonDown="Tab_Click" Tag="Log">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="📝" FontSize="36" Foreground="#B0B0B0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="LOG" FontSize="36" Foreground="#B0B0B0" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="30,0,0,0">
                <Button Content="START" Width="150" FontSize="32" FontWeight="Bold" Command="{Binding StartCommand}" Background="#4CAF50" Foreground="#FFFFFF" Padding="12,6" Margin="10,5,0,5" />
                <Button Content="STOP" Width="150" FontSize="32" FontWeight="Bold" Command="{Binding StopCommand}" Background="#F44336" Foreground="#FFFFFF" Padding="12,6" Margin="10,5,0,5" />
                <Button Content="RESET" Width="150" FontSize="32" FontWeight="Bold" Command="{Binding ResetCommand}" Background="#FF9800" Foreground="#FFFFFF" Padding="12,6" Margin="10,5,0,5" />
                <Button Content="HOME" Width="150" FontSize="32" FontWeight="Bold" Command="{Binding HomeAllCommand}" Background="#2196F3" Foreground="#FFFFFF" Padding="12,6" Margin="10,5,10,5" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
