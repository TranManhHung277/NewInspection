<UserControl x:Class="NAutoSuite.UI.Controls.ShellFooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="100">
    <UserControl.Resources>
        <Style x:Key="FooterActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Base"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <Border x:Name="HoverOverlay" Background="#22FFFFFF" CornerRadius="6" Opacity="0"/>
                            <Border x:Name="PressedOverlay" Background="#33000000" CornerRadius="6" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressedOverlay" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <UniformGrid Rows="1" Columns="5" >
                <!-- Auto Tab -->
                <Border x:Name="AutoTab" Background="#1E1E1E" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand" 
                        MouseLeftButtonDown="Tab_Click" Tag="Auto">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="▶" FontSize="36" Foreground="#2196F3"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="AUTO" FontSize="36" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Manual Tab -->
                <Border x:Name="ManualTab" Background="Transparent" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand" 
                        MouseLeftButtonDown="Tab_Click" Tag="Manual">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="🎮" FontSize="36" Foreground="#B0B0B0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="MANUAL" FontSize="36" Foreground="#B0B0B0" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    </StackPanel>
                </Border>

                <!-- Data Tab -->
                <Border x:Name="DataTab" Background="Transparent" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand" 
                        MouseLeftButtonDown="Tab_Click" Tag="Data">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="36" Foreground="#B0B0B0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="DATA" FontSize="36" Foreground="#B0B0B0" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    </StackPanel>
                </Border>

                <!-- Setting Tab -->
                <Border x:Name="SettingTab" Background="Transparent" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand" 
                        MouseLeftButtonDown="Tab_Click" Tag="Setting">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="36" Foreground="#B0B0B0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="SETTING" FontSize="36" Foreground="#B0B0B0" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    </StackPanel>
                </Border>

                <!-- Log Tab -->
                <Border x:Name="LogTab" Background="Transparent" BorderBrush="#3E3E42"
                        BorderThickness="0,0,1,0" Cursor="Hand"
                        MouseLeftButtonDown="Tab_Click" Tag="Log">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="📝" FontSize="36" Foreground="#B0B0B0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Text="LOG" FontSize="36" Foreground="#B0B0B0" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="30,0,0,0">
                <Button Content="START" Width="150" FontSize="32" FontWeight="Bold" Command="{Binding StartCommand}" Background="#4CAF50" Foreground="#FFFFFF" Padding="12,6" Margin="10,5,0,5" Style="{StaticResource FooterActionButtonStyle}" />
                <Button Content="STOP" Width="150" FontSize="32" FontWeight="Bold" Command="{Binding StopCommand}" Background="#F44336" Foreground="#FFFFFF" Padding="12,6" Margin="10,5,0,5" Style="{StaticResource FooterActionButtonStyle}" />
                <Button Content="RESET" Width="150" FontSize="32" FontWeight="Bold" Command="{Binding ResetCommand}" Background="#FF9800" Foreground="#FFFFFF" Padding="12,6" Margin="10,5,0,5" Style="{StaticResource FooterActionButtonStyle}" />
                <Button Content="HOME" Width="150" FontSize="32" FontWeight="Bold" Background="#2196F3" Foreground="#FFFFFF" Padding="12,6" Margin="10,5,10,5" Style="{StaticResource FooterActionButtonStyle}" PreviewMouseLeftButtonDown="HomeHoldStart" PreviewMouseLeftButtonUp="HomeHoldEnd" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
