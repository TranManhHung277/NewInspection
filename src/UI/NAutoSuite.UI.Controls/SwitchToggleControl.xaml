<UserControl x:Class="NAutoSuite.UI.Controls.SwitchToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="32"
             d:DesignWidth="80">
    <UserControl.Resources>
        <Storyboard x:Key="SwitchOn">
            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                Storyboard.TargetProperty="Margin"
                                To="0,0,0,0"
                                Duration="0:0:0.15">
                <ThicknessAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
            <ColorAnimation Storyboard.TargetName="TrackBorder"
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="#4CAF50"
                            Duration="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Key="SwitchOff">
            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                Storyboard.TargetProperty="Margin"
                                To="0,0,0,0"
                                Duration="0:0:0.15">
                <ThicknessAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
            <ColorAnimation Storyboard.TargetName="TrackBorder"
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="#3E3E42"
                            Duration="0:0:0.15"/>
        </Storyboard>
    </UserControl.Resources>

    <ToggleButton x:Name="Toggle"
                  MinWidth="70"
                  MinHeight="28"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Cursor="Hand"
                  IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                  Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="TrackBorder"
                        Background="#3E3E42"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <!-- OFF Label (bên trái) -->
                        <TextBlock x:Name="OffText"
                                   Text="{Binding OffLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="#999"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <!-- ON Label (bên phải) -->
                        <TextBlock x:Name="OnText"
                                   Text="{Binding OnLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Opacity="0"/>

                        <!-- Thumb (nút trượt) -->
                        <Border x:Name="Thumb"
                                Width="24"
                                Height="24"
                                Background="White"
                                CornerRadius="12"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1"
                                                  BlurRadius="3"
                                                  Opacity="0.3"
                                                  Direction="270"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="TrackBorder" Property="Background" Value="#4CAF50"/>
                        <Setter TargetName="TrackBorder" Property="BorderBrush" Value="#43A047"/>
                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                        <Setter TargetName="OnText" Property="Opacity" Value="1"/>
                        <Setter TargetName="OffText" Property="Opacity" Value="0"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="TrackBorder" Property="BorderBrush" Value="#777"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="TrackBorder" Property="BorderBrush" Value="#66BB6A"/>
                    </MultiTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ToggleButton.Template>
    </ToggleButton>
</UserControl>
