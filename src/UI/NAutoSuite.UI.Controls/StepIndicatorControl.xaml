<UserControl x:Class="NAutoSuite.UI.Controls.StepIndicatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="400">

    <Border Background="#2D2D30"
            BorderBrush="#3E3E42"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0"
                       Margin="0,0,0,12"
                       Visibility="{Binding TitleVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#B0B0B0"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ProgressText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#6E6E6E"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- Steps -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Steps, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Step indicator and connector -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left connector -->
                                <Border Grid.Column="0"
                                        Height="3"
                                        VerticalAlignment="Center"
                                        Background="{Binding LeftConnectorBrush}"
                                        Visibility="{Binding LeftConnectorVisibility}"/>

                                <!-- Step circle -->
                                <Grid Grid.Column="1"
                                      Width="28" Height="28">
                                    <!-- Background circle -->
                                    <Ellipse Fill="{Binding BackgroundBrush}"
                                             Stroke="{Binding BorderBrush}"
                                             StrokeThickness="2"/>

                                    <!-- Step number or check mark -->
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontFamily="{Binding FontFamily}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{Binding ForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Right connector -->
                                <Border Grid.Column="2"
                                        Height="3"
                                        VerticalAlignment="Center"
                                        Background="{Binding RightConnectorBrush}"
                                        Visibility="{Binding RightConnectorVisibility}"/>
                            </Grid>

                            <!-- Step name -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Name}"
                                       Foreground="{Binding NameForeground}"
                                       FontSize="10"
                                       FontWeight="{Binding NameFontWeight}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,6,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
