<UserControl x:Class="NAutoSuite.UI.Controls.ParameterInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="36"
             d:DesignWidth="280">

    <Border Background="#252526"
            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Label and Value input -->
            <Grid Grid.Column="0"
                  Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Parameter label -->
                <TextBlock Grid.Column="0"
                           Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#B0B0B0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding LabelVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <!-- Value input -->
                <TextBox x:Name="ValueInput"
                         Grid.Column="1"
                         Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="White"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         FontFamily="Consolas"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Stretch"
                         TextAlignment="{Binding TextAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         GotFocus="ValueInput_GotFocus"
                         LostFocus="ValueInput_LostFocus"
                         PreviewTextInput="ValueInput_PreviewTextInput"
                         PreviewKeyDown="ValueInput_PreviewKeyDown"/>
            </Grid>

            <!-- Unit display -->
            <Border Grid.Column="1"
                    Background="#1E1E1E"
                    Padding="8,0"
                    Visibility="{Binding UnitVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#6E6E6E"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Increment/Decrement buttons -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Visibility="{Binding SpinButtonsVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button Content="-"
                        Width="28"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="DecrementButton_Click"
                        Style="{StaticResource SpinButtonStyle}"/>
                <Button Content="+"
                        Width="28"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="IncrementButton_Click"
                        Style="{StaticResource SpinButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>

    <UserControl.Resources>
        <Style x:Key="SpinButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
</UserControl>
