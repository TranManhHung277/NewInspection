<UserControl x:Class="NAutoSuite.UI.Controls.GaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="160"
             d:DesignWidth="160">

    <Grid>
        <Canvas x:Name="GaugeCanvas"
                Width="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}}">

            <!-- Background arc -->
            <Path Stroke="#3E3E42"
                  StrokeThickness="{Binding ArcThickness, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="{Binding BackgroundArcData, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- Value arc -->
            <Path Stroke="{Binding ValueBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="{Binding ArcThickness, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="{Binding ValueArcData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Path.Effect>
                    <DropShadowEffect ShadowDepth="0"
                                      BlurRadius="6"
                                      Opacity="0.5"
                                      Color="{Binding ValueColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Path.Effect>
            </Path>

            <!-- Tick marks container -->
            <Canvas x:Name="TickCanvas"/>

            <!-- Needle (optional) -->
            <Path x:Name="Needle"
                  Fill="{Binding NeedleBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Data="{Binding NeedleData, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Visibility="{Binding NeedleVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  RenderTransformOrigin="0.5,0.9">
                <Path.RenderTransform>
                    <RotateTransform Angle="{Binding NeedleAngle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Path.RenderTransform>
            </Path>

            <!-- Center circle (for needle pivot) -->
            <Ellipse x:Name="CenterCircle"
                     Width="12" Height="12"
                     Fill="#2D2D30"
                     Stroke="{Binding ValueBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     StrokeThickness="2"
                     Visibility="{Binding NeedleVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Canvas>

        <!-- Center content -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <TextBlock Text="{Binding DisplayValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="White"
                       FontSize="{Binding ValueFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontWeight="Bold"
                       FontFamily="Consolas"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="#6E6E6E"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Visibility="{Binding UnitVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="#B0B0B0"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Visibility="{Binding LabelVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>

        <!-- Min/Max labels -->
        <TextBlock Text="{Binding Minimum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="#6E6E6E"
                   FontSize="9"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="15,0,0,5"/>
        <TextBlock Text="{Binding Maximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="#6E6E6E"
                   FontSize="9"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,15,5"/>
    </Grid>
</UserControl>
