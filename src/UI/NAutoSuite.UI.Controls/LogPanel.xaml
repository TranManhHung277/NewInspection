<UserControl x:Class="NAutoSuite.UI.Controls.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NAutoSuite.UI.Controls.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1920">

    <UserControl.DataContext>
        <vm:LogPanelViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="28" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding FilteredLogs.Count, StringFormat=' ({0} entries)'}"
                       FontSize="16" Foreground="#808080"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Toolbar: Filter and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Filter:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Log Level Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <CheckBox Content="Debug" IsChecked="{Binding ShowDebug}"
                              Foreground="#757575" Margin="0,0,10,0"/>
                    <CheckBox Content="Info" IsChecked="{Binding ShowInformation}"
                              Foreground="#1976D2" Margin="0,0,10,0"/>
                    <CheckBox Content="Warning" IsChecked="{Binding ShowWarning}"
                              Foreground="#FFA726" Margin="0,0,10,0"/>
                    <CheckBox Content="Error" IsChecked="{Binding ShowError}"
                              Foreground="#E53935" Margin="0,0,10,0"/>
                    <CheckBox Content="Fatal" IsChecked="{Binding ShowFatal}"
                              Foreground="#C62828"/>
                </StackPanel>

                <!-- Search Box -->
                <TextBox Width="250" Height="32"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#2D2D30" Foreground="White"
                         BorderBrush="#3F3F46" BorderThickness="1"
                         VerticalContentAlignment="Center" Padding="8,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search logs..."
                                                               Foreground="#808080"
                                                               Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <CheckBox Content="Auto-scroll"
                          IsChecked="{Binding AutoScrollEnabled}"
                          Foreground="#B0B0B0"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <Button Content="Clear" Width="100" Height="32" Margin="0,0,10,0"
                        Command="{Binding ClearLogsCommand}"
                        Background="#C62828" Foreground="White"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="12,6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D32F2F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Export" Width="100" Height="32"
                        Command="{Binding ExportLogsCommand}"
                        Background="#1976D2" Foreground="White"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="12,6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E88E5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Log Display -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#3F3F46"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="10">
                <ItemsControl ItemsSource="{Binding FilteredLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1"
                                    Padding="8,4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss.fff}]'}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="#808080" Margin="0,0,10,0"/>

                                    <!-- Level Badge -->
                                    <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                            Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#555555"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Information">
                                                        <Setter Property="Background" Value="#1976D2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Background" Value="#FFA726"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Background" Value="#E53935"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Fatal">
                                                        <Setter Property="Background" Value="#C62828"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                        <Setter Property="Background" Value="#757575"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Verbose">
                                                        <Setter Property="Background" Value="#9E9E9E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Level}"
                                                   FontFamily="Consolas" FontSize="10"
                                                   Foreground="White" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Message -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="#E0E0E0"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
