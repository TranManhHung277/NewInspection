<UserControl x:Class="NAutoSuite.UI.Controls.AxisPositionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="200">

    <Border Background="#2D2D30"
            BorderBrush="#3E3E42"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with axis name and status -->
            <DockPanel Grid.Row="0">
                <TextBlock Text="{Binding AxisName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#B0B0B0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- Status indicators -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <!-- Home indicator -->
                    <Ellipse x:Name="HomeIndicator"
                             Width="8" Height="8"
                             Margin="4,0"
                             ToolTip="Home"
                             Fill="{Binding HomeBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <!-- Alarm indicator -->
                    <Ellipse x:Name="AlarmIndicator"
                             Width="8" Height="8"
                             ToolTip="Alarm"
                             Fill="{Binding AlarmBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </DockPanel>

            <!-- Position display -->
            <DockPanel Grid.Row="1"
                       VerticalAlignment="Center"
                       Margin="0,8,0,0">
                <TextBlock Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#6E6E6E"
                           FontSize="14"
                           FontWeight="Normal"
                           VerticalAlignment="Bottom"
                           Margin="4,0,0,2"
                           DockPanel.Dock="Right"/>

                <TextBlock Text="{Binding Position, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:F3}'}"
                           Foreground="{Binding PositionForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="28"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
