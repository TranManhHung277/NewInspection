<Window x:Class="NAutoSuite.UI.Controls.Dialogs.NumericKeyboardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numeric Keyboard"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        Width="420"
        SizeToContent="Height"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="KeyButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="64"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8,8,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CancelButton_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock Text="X" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Display -->
            <Border Grid.Row="1" Margin="12,10,12,6" Background="{StaticResource BackgroundBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBox x:Name="DisplayBox"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="20"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         HorizontalContentAlignment="Right"
                         Padding="12,8"
                         IsReadOnly="True"/>
            </Border>

            <!-- Keys -->
            <Grid Grid.Row="2" Margin="12,6,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="7"/>
                <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="8"/>
                <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="9"/>
                <Button Grid.Row="0" Grid.Column="3" Content="Back" Style="{StaticResource KeyButtonStyle}" Click="BackspaceButton_Click"/>

                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="4"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="5"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="6"/>
                <Button Grid.Row="1" Grid.Column="3" Content="Clear" Style="{StaticResource KeyButtonStyle}" Click="ClearButton_Click"/>

                <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="1"/>
                <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="3"/>
                <Button Grid.Row="2" Grid.Column="3" Content="-" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="-"/>

                <Button Grid.Row="3" Grid.Column="0" Content="0" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="0"/>
                <Button Grid.Row="3" Grid.Column="1" Content="." Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="."/>
                <Button Grid.Row="3" Grid.Column="2" Content="OK" Style="{StaticResource PrimaryButton}" Click="OkButton_Click" Margin="2"/>
                <Button Grid.Row="3" Grid.Column="3" Content="Cancel" Style="{StaticResource ErrorButton}" Click="CancelButton_Click" Margin="2"/>
            </Grid>

        </Grid>
    </Border>
</Window>
