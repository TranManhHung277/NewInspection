<Window x:Class="NAutoSuite.UI.Controls.Dialogs.ErrorListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Error List"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        Width="700"
        Height="500"
        ShowInTaskbar="False">

    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Error List -->
                <RowDefinition Height="70"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0D1117" CornerRadius="8,8,0,0" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Error Icon -->
                        <Border Background="#DA3633" Width="32" Height="32" CornerRadius="6" Margin="0,0,15,0">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <!-- Title with count -->
                        <StackPanel>
                            <TextBlock Text="System Errors Detected" FontSize="18" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                            <TextBlock x:Name="ErrorCountText" Text="0 errors found" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Error List -->
            <Border Grid.Row="1" Background="#0D1117" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ErrorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1"
                                        CornerRadius="6" Margin="0,0,0,8" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Error Icon -->
                                        <Border Grid.Column="0" Background="#DA3633" Width="24" Height="24"
                                                CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="!" FontSize="14" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Error Details -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Message}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#C9D1D9" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Source}" FontSize="12" Foreground="#8B949E"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='Time: {0:HH:mm:ss}'}"
                                                       FontSize="11" Foreground="#6E7681" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Severity Badge -->
                                        <Border Grid.Column="2" Background="#58A6FF" Padding="8,4" CornerRadius="4"
                                                Height="24" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Footer with Buttons -->
            <Border Grid.Row="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0">
                    <Button x:Name="ClearButton" Content="Clear All" Click="ClearButton_Click"
                            MinWidth="100" Height="36" Margin="0,0,10,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="16,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#383E45"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#282C31"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click"
                            MinWidth="100" Height="36" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1F6FEB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="16,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#307EF5"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#165DCF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
