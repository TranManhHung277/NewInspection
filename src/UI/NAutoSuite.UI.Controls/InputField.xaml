<UserControl x:Class="NAutoSuite.UI.Controls.InputField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinHeight="36"
             d:DesignHeight="36" d:DesignWidth="260">
    <UserControl.Resources>
        <Style x:Key="KeyboardButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <SolidColorBrush x:Key="DefaultInvalidBrush" Color="#E53935"/>
    </UserControl.Resources>

    <Border x:Name="MainBorder"
            Background="{Binding InputBackground, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue={StaticResource SurfaceBrush}}"
            BorderThickness="1"
            CornerRadius="8"
            Height="{Binding InputHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Padding="0,2"
            ToolTip="{Binding ValidationErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{Binding InputBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue={StaticResource BorderBrush}}"/>
                <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsValid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="BorderBrush" Value="{Binding InvalidBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue={StaticResource DefaultInvalidBrush}}"/>
                        <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10,0"
                     FontSize="{Binding ActualFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontFamily="{Binding InputFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontWeight="{Binding InputFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     TextAlignment="{Binding HorizontalTextAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     VerticalContentAlignment="{Binding VerticalTextAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     VerticalAlignment="Stretch"
                     Foreground="{Binding InputForeground, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue={StaticResource TextPrimaryBrush}}"
                     Style="{Binding TextBoxStyle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Text="{Binding PendingText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     GotKeyboardFocus="InputBox_GotKeyboardFocus"
                     PreviewKeyDown="InputBox_OnPreviewKeyDown"/>

            <Button Grid.Column="1"
                    Style="{StaticResource KeyboardButtonStyle}"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowKeyboardButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="KeyboardButton_Click">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,6 L21,6 C22.1,6 23,6.9 23,8 L23,18 C23,19.1 22.1,20 21,20 L3,20 C1.9,20 1,19.1 1,18 L1,8 C1,6.9 1.9,6 3,6 Z M4,9 L6,9 L6,11 L4,11 Z M7,9 L9,9 L9,11 L7,11 Z M10,9 L12,9 L12,11 L10,11 Z M13,9 L15,9 L15,11 L13,11 Z M16,9 L18,9 L18,11 L16,11 Z M19,9 L21,9 L21,11 L19,11 Z M4,13 L8,13 L8,15 L4,15 Z M9,13 L13,13 L13,15 L9,15 Z M14,13 L18,13 L18,15 L14,15 Z M19,13 L21,13 L21,15 L19,15 Z M6,17 L18,17 L18,19 L6,19 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</UserControl>
