<UserControl x:Class="NAutoSuite.UI.Controls.ShellHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="1920">
    <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
        <Grid Height="80" Margin="20,0">
            <Grid.ColumnDefinitions>
                <!-- Machine Number -->
                <ColumnDefinition Width="Auto"/>
                <!-- Status -->
                <ColumnDefinition Width="Auto"/>
                <!-- Alarm -->
                <ColumnDefinition Width="Auto"/>
                <!-- Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Project Name (Center) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Logo/Time -->
                <ColumnDefinition Width="Auto"/>
                <!-- Close Button -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Machine Number -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="4"
                    Padding="16,8" Margin="0,0,20,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="#" FontSize="24" FontWeight="Bold"
                               Foreground="#2196F3" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MachineNumber" Text="1" FontSize="24"
                               FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Machine State -->
            <local:MachineStateControl Grid.Column="1" x:Name="StateControl"
                                      Margin="0,0,20,0" VerticalAlignment="Center"/>

            <!-- Alarm Indicator -->
            <Border Grid.Column="2" Background="#252526" CornerRadius="4"
                    Padding="12,8" Margin="0,0,20,0" VerticalAlignment="Center"
                    x:Name="AlarmBorder">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="AlarmIndicator" Width="16" Height="16"
                             Fill="Gray" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AlarmText" Text="No Alarm"
                               Foreground="White" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Project Name (Center) -->
            <TextBlock Grid.Column="4" x:Name="ProjectName"
                       Text="NAutoSuite Project"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <!-- Logo and Time -->
            <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,0,20,0">
                <!-- Logo -->
                <Border Background="#2196F3" CornerRadius="4"
                        Width="60" Height="30" Margin="0,0,0,4">
                    <TextBlock Text="LOGO" FontSize="12" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <!-- Current Time -->
                <TextBlock x:Name="CurrentTime" Text="00:00:00"
                           FontSize="12" Foreground="#B0B0B0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="7" Content="✕"
                    Width="40" Height="40"
                    FontSize="20" FontWeight="Bold"
                    Background="#F44336"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    x:Name="CloseButton">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
