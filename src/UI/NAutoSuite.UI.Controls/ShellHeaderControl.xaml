<UserControl x:Class="NAutoSuite.UI.Controls.ShellHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="70" 
             d:DesignWidth="1920"
             PreviewMouseLeftButtonUp="HeaderControl_PreviewMouseLeftButtonUp">
    <Border x:Name="MainBorder"
            Background="#2D2D30"
            BorderBrush="#3E3E42"
            BorderThickness="0,0,0,1"
            Cursor="Hand"
            MouseLeftButtonUp="MainBorder_MouseLeftButtonUp">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid Width="1920" Height="70">
            <Grid.ColumnDefinitions>
                <!-- Left Content -->
                <ColumnDefinition Width="*"/>
                <!-- Center - Machine Name (always centered) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Right Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Content -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Station Number & Model Name -->
                <Border Background="#1F6FEB"
                        Padding="10,0"
                        VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Machine Number -->
                        <TextBlock x:Name="MachineNumber"
                                   Text="99"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <!-- Separator -->
                        <Border Width="2" Background="#FFFFFF" Opacity="0.3"
                                Margin="10,8" VerticalAlignment="Stretch"/>

                        <!-- Model Name -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MODEL"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#B0D4FF"
                                       Margin="0,0,0,2"/>
                            <TextBlock x:Name="ModelName"
                                       Text="No Model"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Machine State -->
                <local:MachineStateControl x:Name="StateControl"
                                           HorizontalAlignment="Center"/>

                <!-- Separator -->
                <Border Width="2" Background="#FFFFFF" Opacity="0.3"
                        Margin="10,8" VerticalAlignment="Stretch"/>

                <!-- Run Mode -->
                <local:RunModeControl x:Name="RunModeControl"
                                      Margin="12,8,0,8"
                                      VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Center - Machine Name (Always Centered) -->
            <TextBlock Grid.Column="1"
                       x:Name="ProjectName"
                       Text="EVI INSPECTION"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Right Content -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Width="500"
                            Margin="25,0,25,0">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="LogoText"
                                   Text="SEMV"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#1F6FEB"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Time & Date -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="CurrentTime"
                                   Text="00:00:00 12/12/2025"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#8B949E"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Border Background="#F44336" Width="70">
                    <Button Content="✕"
                            FontSize="40" FontWeight="Bold"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            x:Name="CloseButton" Width="70">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D32F2F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </StackPanel>
        </Grid>
        </Viewbox>
    </Border>
</UserControl>
