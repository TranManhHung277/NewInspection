<UserControl x:Class="NAutoSuite.UI.Controls.ShellHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="1920">
    <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
        <Grid Height="60">
            <Grid.ColumnDefinitions>
                <!-- Machine Number -->
                <ColumnDefinition Width="Auto"/>
                <!-- Status -->
                <ColumnDefinition Width="Auto"/>
                <!-- Alarm -->
                <ColumnDefinition Width="Auto"/>
                <!-- Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Project Name (Center) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Logo/Time -->
                <ColumnDefinition Width="Auto"/>
                <!-- Close Button -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Machine Number -->
            <Border Grid.Column="0" Background="#1E1E1E"
                    Height="60" MinWidth="120"
                    BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="#" FontSize="20" FontWeight="Bold"
                               Foreground="#2196F3" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MachineNumber" Text="1" FontSize="20"
                               FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Machine State -->
            <Border Grid.Column="1" Background="#1E1E1E"
                    Height="60" MinWidth="150"
                    BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
                <local:MachineStateControl x:Name="StateControl"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
            </Border>

            <!-- Alarm Indicator -->
            <Border Grid.Column="2" Background="#1E1E1E"
                    Height="60" MinWidth="200"
                    BorderBrush="#3E3E42" BorderThickness="0,0,1,0"
                    x:Name="AlarmBorder">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="AlarmIndicator" Width="12" Height="12"
                             Fill="Gray" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AlarmText" Text="No Alarm"
                               FontSize="14" Foreground="White" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Project Name (Center) -->
            <Border Grid.Column="4" Background="#2D2D30" Height="60">
                <TextBlock x:Name="ProjectName"
                           Text="NAutoSuite Project"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Logo and Time -->
            <Border Grid.Column="6" Background="#1E1E1E"
                    Height="60" MinWidth="120"
                    BorderBrush="#3E3E42" BorderThickness="1,0,1,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Logo -->
                    <TextBlock Text="SEMV" FontSize="16" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <!-- Current Time -->
                    <TextBlock x:Name="CurrentTime" Text="00:00:00"
                               FontSize="11" Foreground="#B0B0B0"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Close Button -->
            <Border Grid.Column="7" Background="#F44336" Height="60" Width="60">
                <Button Content="✕"
                        FontSize="24" FontWeight="Bold"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        x:Name="CloseButton"
                        Height="60" Width="60">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D32F2F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
