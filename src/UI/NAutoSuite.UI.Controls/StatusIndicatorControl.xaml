<UserControl x:Class="NAutoSuite.UI.Controls.StatusIndicatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="120">
    <UserControl.Resources>
        <SolidColorBrush x:Key="OffColor" Color="#6E6E6E"/>
        <SolidColorBrush x:Key="OnColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#F44336"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FFC107"/>
        <SolidColorBrush x:Key="InfoColor" Color="#2196F3"/>
    </UserControl.Resources>

    <Border Background="Transparent"
            Padding="4">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
            <!-- LED Indicator -->
            <Grid Width="{Binding IndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Height="{Binding IndicatorSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <!-- Outer glow effect when active -->
                <Ellipse x:Name="GlowEffect"
                         Fill="{Binding IndicatorBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Opacity="0.3">
                    <Ellipse.Effect>
                        <BlurEffect Radius="8"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Main LED -->
                <Ellipse x:Name="MainLed"
                         Fill="{Binding IndicatorBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Stroke="#1E1E1E"
                         StrokeThickness="1">
                    <Ellipse.Effect>
                        <DropShadowEffect ShadowDepth="0"
                                          BlurRadius="4"
                                          Opacity="0.5"
                                          Color="{Binding IndicatorColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Highlight reflection -->
                <Ellipse Margin="3,2,3,0"
                         VerticalAlignment="Top"
                         Height="6"
                         Fill="White"
                         Opacity="0.3"/>
            </Grid>

            <!-- Label -->
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Visibility="{Binding LabelVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Border>
</UserControl>
