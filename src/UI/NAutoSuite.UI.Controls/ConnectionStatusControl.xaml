<UserControl x:Class="NAutoSuite.UI.Controls.ConnectionStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="200">

    <UserControl.Resources>
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0"
                             Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="PulseRingScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="2"
                             Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="PulseRingScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="2"
                             Duration="0:0:1"/>
        </Storyboard>
    </UserControl.Resources>

    <Border Background="#252526"
            BorderBrush="#3E3E42"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Connection indicator with pulse -->
            <Grid Grid.Column="0"
                  Width="24" Height="24"
                  Margin="0,0,10,0">
                <!-- Pulse ring (animated when connecting) -->
                <Ellipse x:Name="PulseRing"
                         Fill="{Binding StatusBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseRingScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Main indicator -->
                <Ellipse Width="12" Height="12"
                         Fill="{Binding StatusBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect ShadowDepth="0"
                                          BlurRadius="4"
                                          Opacity="0.5"
                                          Color="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- Connection info -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding DeviceName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding StatusBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="10"/>
            </StackPanel>

            <!-- Latency/Ping indicator -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding LatencyVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="{Binding Latency, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0}ms'}"
                           Foreground="{Binding LatencyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11"
                           FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
