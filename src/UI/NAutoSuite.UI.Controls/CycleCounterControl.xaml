<UserControl x:Class="NAutoSuite.UI.Controls.CycleCounterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="140"
             d:DesignWidth="280">

    <Border Background="#2D2D30"
            BorderBrush="#3E3E42"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#B0B0B0"
                           FontSize="14"
                           FontWeight="SemiBold"/>

                <!-- Reset button -->
                <Button x:Name="ResetButton"
                        Content="&#xE72C;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Foreground="#6E6E6E"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        ToolTip="Reset Counter"
                        Visibility="{Binding ResetButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding ResetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>

            <!-- Main counters -->
            <Grid Grid.Row="1"
                  Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total count -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalCount, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:N0}'}"
                               Foreground="#2196F3"
                               FontSize="32"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Total"
                               Foreground="#6E6E6E"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="#3E3E42"
                        Margin="16,0"/>

                <!-- Pass/Fail counts -->
                <Grid Grid.Column="2"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- OK count -->
                    <Ellipse Grid.Row="0" Grid.Column="0"
                             Width="10" Height="10"
                             Fill="#4CAF50"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding OkCount, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:N0}'}"
                                   Foreground="#4CAF50"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"/>
                        <TextBlock Text=" OK"
                                   Foreground="#6E6E6E"
                                   FontSize="11"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,2"/>
                    </StackPanel>

                    <!-- NG count -->
                    <Ellipse Grid.Row="1" Grid.Column="0"
                             Width="10" Height="10"
                             Fill="#F44336"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding NgCount, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:N0}'}"
                                   Foreground="#F44336"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"/>
                        <TextBlock Text=" NG"
                                   Foreground="#6E6E6E"
                                   FontSize="11"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,2"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Yield rate bar -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,4">
                    <TextBlock Text="Yield"
                               Foreground="#6E6E6E"
                               FontSize="11"/>
                    <TextBlock Text="{Binding YieldRate, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:F1}%'}"
                               Foreground="{Binding YieldBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <Border Grid.Row="1"
                        Height="6"
                        Background="#3E3E42"
                        CornerRadius="3">
                    <Border Background="{Binding YieldBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="{Binding YieldWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
