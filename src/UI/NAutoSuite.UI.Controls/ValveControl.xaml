<UserControl x:Class="NAutoSuite.UI.Controls.ValveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="50"
             d:DesignWidth="180">

    <Border Background="#252526"
            BorderBrush="#3E3E42"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Valve symbol -->
            <Grid Grid.Column="0"
                  Width="32" Height="32"
                  Margin="0,0,10,0">
                <!-- Valve body -->
                <Path Data="M4,12 L12,6 L12,18 Z M20,6 L20,18 L28,12 Z"
                      Fill="{Binding ValveBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Stretch="Uniform"
                      Width="28" Height="20"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

                <!-- Flow indicator (center line) -->
                <Rectangle x:Name="FlowLine"
                           Width="4"
                           Height="8"
                           Fill="{Binding FlowBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RadiusX="2"
                           RadiusY="2"/>
            </Grid>

            <!-- Valve info -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ValveName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding StatusBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="10"/>
            </StackPanel>

            <!-- Toggle button -->
            <ToggleButton Grid.Column="2"
                          Width="40" Height="22"
                          IsChecked="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                          Visibility="{Binding ToggleVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Command="{Binding ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          VerticalAlignment="Center">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="#3E3E42"
                                BorderBrush="#555"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Grid>
                                <Border x:Name="Thumb"
                                        Width="18" Height="18"
                                        Background="White"
                                        CornerRadius="9"
                                        HorizontalAlignment="Left"
                                        Margin="2,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="1"
                                                          BlurRadius="2"
                                                          Opacity="0.3"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#43A047"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
