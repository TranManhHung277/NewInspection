<UserControl x:Class="NAutoSuite.UI.Controls.AlarmIndicatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60"
             d:DesignWidth="300">

    <UserControl.Resources>
        <Storyboard x:Key="BlinkAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AlarmIcon"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3"
                             Duration="0:0:0.5"
                             AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="MainBorder"
            Background="{Binding BackgroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Alarm icon -->
            <Grid Grid.Column="0"
                  Width="36" Height="36"
                  Margin="0,0,12,0">
                <Ellipse Fill="{Binding IconBackgroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Opacity="0.2"/>
                <TextBlock x:Name="AlarmIcon"
                           Text="{Binding IconText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="{Binding IconForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Alarm content -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#B0B0B0"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding MessageVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>

            <!-- Acknowledge button -->
            <Button Grid.Column="2"
                    Content="ACK"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#3E3E42"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Visibility="{Binding AckButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Command="{Binding AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#606060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
