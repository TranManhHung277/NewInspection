<UserControl x:Class="EVIInspection.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EVIInspection.Views"
             xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="SETTING" FontSize="22" FontWeight="Bold"
               Foreground="White" Margin="0,0,0,12"/>

        <!-- Content -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                
                <controls:KeyboardInput Text="{Binding MachineNumber}"
                                    KeyboardType="Numeric"
                                    ShowKeyboardButton="True"/>
            </StackPanel>
               

                           

        </Grid>
    </Grid>
</UserControl>
