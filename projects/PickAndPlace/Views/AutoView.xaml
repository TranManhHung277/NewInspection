<UserControl x:Class="PickAndPlace.Views.AutoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1920">

    <UserControl.Resources>
        <!-- Blinking Animation for Tower Lights -->
        <Storyboard x:Key="BlinkingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="1.0" To="0.2" Duration="0:0:0.5"
                           AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Automatic Mode - EtherCAT Simulation" FontSize="22" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,12"/>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Machine Status & Axis Info -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Machine State & Status -->
                    <TextBlock Text="Machine Status" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Status Message -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status: " FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="16"
                                       Foreground="White" TextWrapping="Wrap" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Cycle Count -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Cycles" FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CycleCount}" FontSize="24"
                                       FontWeight="Bold" Foreground="#2196F3"/>
                        </Grid>
                    </Border>

                    <!-- Run Time -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Run Time" FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding RunTime}" FontSize="20"
                                       Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Axis Positions -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Axis Positions" FontSize="16" Foreground="#B0B0B0" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="X:" FontSize="14" Foreground="#B0B0B0"/>
                                <TextBlock Text="{Binding AxisXPosition, StringFormat=' {0:F2}'}" FontSize="16"
                                           Foreground="#4CAF50" FontWeight="Bold"/>
                                <TextBlock Text=" mm" FontSize="12" Foreground="#B0B0B0" Margin="4,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Y:" FontSize="14" Foreground="#B0B0B0"/>
                                <TextBlock Text="{Binding AxisYPosition, StringFormat=' {0:F2}'}" FontSize="16"
                                           Foreground="#4CAF50" FontWeight="Bold"/>
                                <TextBlock Text=" mm" FontSize="12" Foreground="#B0B0B0" Margin="4,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Z:" FontSize="14" Foreground="#B0B0B0"/>
                                <TextBlock Text="{Binding AxisZPosition, StringFormat=' {0:F2}'}" FontSize="16"
                                           Foreground="#4CAF50" FontWeight="Bold"/>
                                <TextBlock Text=" mm" FontSize="12" Foreground="#B0B0B0" Margin="4,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Auto Step -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto Step:" FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding AutoStep}" FontSize="16"
                                       Foreground="White" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Tower Lights Visualization -->
                    <Border Background="#1E1E1E" Padding="20" CornerRadius="8" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Tower Lights" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,16" HorizontalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Red Light -->
                                <Border Width="60" Height="60" CornerRadius="30" Margin="10"
                                        Background="{Binding TowerLightRed, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Red'}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RedBlink}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="RedBlinkStoryboard"
                                                                     Storyboard="{StaticResource BlinkingAnimation}"/>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="RedBlinkStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="RED" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>

                                <!-- Yellow Light -->
                                <Border Width="60" Height="60" CornerRadius="30" Margin="10"
                                        Background="{Binding TowerLightYellow, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Yellow'}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding YellowBlink}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="YellowBlinkStoryboard"
                                                                     Storyboard="{StaticResource BlinkingAnimation}"/>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="YellowBlinkStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="YELLOW" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="Black"/>
                                </Border>

                                <!-- Green Light -->
                                <Border Width="60" Height="60" CornerRadius="30" Margin="10"
                                        Background="{Binding TowerLightGreen, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green'}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GreenBlink}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="GreenBlinkStoryboard"
                                                                     Storyboard="{StaticResource BlinkingAnimation}"/>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="GreenBlinkStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="GREEN" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- Buzzer Indicator -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Ellipse Width="20" Height="20" Margin="5">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding Buzzer, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Orange'}"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Buzzer}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                               From="1.0" To="0.0" Duration="0:0:0.25"
                                                                               AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="BUZZER" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{Binding Buzzer, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Orange'}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: Control Panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Control Panel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <!-- Run Mode -->
                    <Border Background="#1E1E1E" Padding="8" CornerRadius="8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Run Mode" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="AUTO" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ToggleButton Width="64" Height="24"
                                              IsChecked="{Binding IsManualMode}"
                                              Content="MANUAL" FontSize="11"/>
                                <TextBlock Text="MANUAL" Foreground="#8B949E" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="AUTO" Style="{StaticResource SuccessButton}"
                                        Height="32" FontSize="12" Width="92"
                                        Command="{Binding SetAutoModeCommand}" Margin="0,0,8,0"/>
                                <Button Content="DRY RUN" Style="{StaticResource OutlineButton}"
                                        Height="32" FontSize="12" Width="92"
                                        Command="{Binding SetDryRunModeCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- IO Simulation -->
                    <Border Background="#1E1E1E" Padding="10" CornerRadius="8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="IO Simulation" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                    <Button Content="Part Present" Style="{StaticResource OutlineButton}"
                                            Width="120" Height="28" FontSize="11"
                                            Command="{Binding TogglePartPresentCommand}" Margin="0,0,6,0"/>
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding PartPresent, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green'}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Test OK" Style="{StaticResource OutlineButton}"
                                            Width="120" Height="28" FontSize="11"
                                            Command="{Binding ToggleTestOkCommand}" Margin="0,0,6,0"/>
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding TestOk, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green'}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Button Content="Test NG" Style="{StaticResource OutlineButton}"
                                            Width="120" Height="28" FontSize="11"
                                            Command="{Binding ToggleTestNgCommand}" Margin="0,0,6,0"/>
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding TestNg, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Red'}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Material Low" Style="{StaticResource OutlineButton}"
                                            Width="120" Height="28" FontSize="11"
                                            Command="{Binding ToggleMaterialLowCommand}" Margin="0,0,6,0"/>
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding MaterialLow, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Yellow'}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </StackPanel>
                            </UniformGrid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sensors" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Cyl. Ext" Width="90" Foreground="White" FontSize="11"/>
                                        <Ellipse Width="12" Height="12">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding CylinderExtended, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green'}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Cyl. Ret" Width="90" Foreground="White" FontSize="11"/>
                                        <Ellipse Width="12" Height="12">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding CylinderRetracted, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green'}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Vacuum OK" Width="90" Foreground="White" FontSize="11"/>
                                        <Ellipse Width="12" Height="12">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding VacuumOk, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green'}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Outputs" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Cyl. Ext" Width="90" Foreground="White" FontSize="11"/>
                                        <Ellipse Width="12" Height="12">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding CylinderExtendOutput, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Orange'}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Vacuum On" Width="90" Foreground="White" FontSize="11"/>
                                        <Ellipse Width="12" Height="12">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding VacuumOnOutput, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Orange'}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Simulation Controls -->
                    <Border Background="#1E1E1E" Padding="10" CornerRadius="8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Simulation Controls" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,8">
                                    <TextBlock Text="X Pos" Foreground="#B0B0B0" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Slider Minimum="-50" Maximum="300" Width="160"
                                                Value="{Binding SimulatedXPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding SimulatedXPosition, StringFormat=' {0:F1}'}" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,0">
                                    <TextBlock Text="Y Pos" Foreground="#B0B0B0" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Slider Minimum="-50" Maximum="300" Width="160"
                                                Value="{Binding SimulatedYPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding SimulatedYPosition, StringFormat=' {0:F1}'}" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Z Pos" Foreground="#B0B0B0" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Slider Minimum="-20" Maximum="150" Width="160"
                                                Value="{Binding SimulatedZPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding SimulatedZPosition, StringFormat=' {0:F1}'}" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="1">
                                    <TextBlock Text="Speed" Foreground="#B0B0B0" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Slider Minimum="0" Maximum="200" Width="160"
                                                Value="{Binding SimulatedSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding SimulatedSpeed, StringFormat=' {0:F0}'}" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
