<UserControl x:Class="PickAndPlace.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1920">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Manual Mode" FontSize="28" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,20"/>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Axis X Control -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AXIS X" FontSize="20" FontWeight="SemiBold"
                               Margin="0,0,0,16" HorizontalAlignment="Center"/>

                    <!-- Position Display -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Position" FontSize="14" Foreground="#B0B0B0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AxisXPosition, StringFormat={}{0:F2} mm}"
                                       FontSize="32" Foreground="#2196F3" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AxisXStatus}" FontSize="12"
                                       Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="STATUS" FontSize="14" Foreground="#B0B0B0" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <controls:StatusIndicatorControl Label="Ready" IsActive="{Binding AxisXReady}"/>
                        <controls:StatusIndicatorControl Label="On" IsActive="{Binding AxisXOn}"/>
                        <controls:StatusIndicatorControl Label="Enabled" IsActive="{Binding AxisXEnabled}"/>
                        <controls:StatusIndicatorControl Label="Done" IsActive="{Binding AxisXDone}"/>
                        <controls:StatusIndicatorControl Label="Target" IsActive="{Binding AxisXTargetReached}"/>
                        <controls:StatusIndicatorControl Label="Warning" IsActive="{Binding AxisXWarning}"
                                                         ActiveColor="#FFC107"/>
                        <controls:StatusIndicatorControl Label="Fault" IsActive="{Binding AxisXFault}"
                                                         ActiveColor="#F44336"/>
                    </UniformGrid>

                    <TextBlock Text="{Binding AxisXErrorCode, StringFormat=Error: {0}}"
                               FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,16"/>

                    <!-- JOG Buttons -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- JOG - Button -->
                        <Button Grid.Column="0" Content="◀" FontSize="40" Height="80"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding JogXNegativeCommand}"/>

                        <!-- JOG + Button -->
                        <Button Grid.Column="2" Content="▶" FontSize="40" Height="80"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding JogXPositiveCommand}"/>
                    </Grid>

                    <!-- Absolute Move -->
                    <TextBlock Text="Move to Position" FontSize="14" Foreground="#B0B0B0" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding AxisXTargetPosition}"
                                 Height="40" FontSize="16" VerticalContentAlignment="Center"
                                 Background="#252526" Foreground="White" BorderBrush="#3E3E42"/>

                        <Button Grid.Column="2" Content="GO" Width="80" Height="40"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding MoveAxisXCommand}"/>
                    </Grid>

                    <!-- Home Button -->
                    <Button Content="🏠 HOME AXIS X" Height="50" FontSize="16"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding HomeAxisXCommand}"/>
                </StackPanel>
            </Border>

            <!-- Middle: Axis Y/Z Control -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Axis Y -->
                    <TextBlock Text="AXIS Y" FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,12" HorizontalAlignment="Center"/>

                    <Border Background="#252526" Padding="12" CornerRadius="4" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding AxisYPosition, StringFormat={}{0:F2} mm}"
                                       FontSize="24" Foreground="#2196F3" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="STATUS" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <controls:StatusIndicatorControl Label="Ready" IsActive="{Binding AxisYReady}"/>
                        <controls:StatusIndicatorControl Label="On" IsActive="{Binding AxisYOn}"/>
                        <controls:StatusIndicatorControl Label="Enabled" IsActive="{Binding AxisYEnabled}"/>
                        <controls:StatusIndicatorControl Label="Done" IsActive="{Binding AxisYDone}"/>
                        <controls:StatusIndicatorControl Label="Target" IsActive="{Binding AxisYTargetReached}"/>
                        <controls:StatusIndicatorControl Label="Warning" IsActive="{Binding AxisYWarning}"
                                                         ActiveColor="#FFC107"/>
                        <controls:StatusIndicatorControl Label="Fault" IsActive="{Binding AxisYFault}"
                                                         ActiveColor="#F44336"/>
                    </UniformGrid>

                    <TextBlock Text="{Binding AxisYErrorCode, StringFormat=Error: {0}}"
                               FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="◀" FontSize="30" Height="60"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding JogYNegativeCommand}"/>

                        <Button Grid.Column="2" Content="▶" FontSize="30" Height="60"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding JogYPositiveCommand}"/>
                    </Grid>

                    <Button Content="🏠 HOME Y" Height="40" FontSize="14"
                            Style="{StaticResource SuccessButton}" Margin="0,0,0,24"
                            Command="{Binding HomeAxisYCommand}"/>

                    <!-- Axis Z -->
                    <TextBlock Text="AXIS Z" FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,12" HorizontalAlignment="Center"/>

                    <Border Background="#252526" Padding="12" CornerRadius="4" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding AxisZPosition, StringFormat={}{0:F2} mm}"
                                       FontSize="24" Foreground="#2196F3" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="STATUS" FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <controls:StatusIndicatorControl Label="Ready" IsActive="{Binding AxisZReady}"/>
                        <controls:StatusIndicatorControl Label="On" IsActive="{Binding AxisZOn}"/>
                        <controls:StatusIndicatorControl Label="Enabled" IsActive="{Binding AxisZEnabled}"/>
                        <controls:StatusIndicatorControl Label="Done" IsActive="{Binding AxisZDone}"/>
                        <controls:StatusIndicatorControl Label="Target" IsActive="{Binding AxisZTargetReached}"/>
                        <controls:StatusIndicatorControl Label="Warning" IsActive="{Binding AxisZWarning}"
                                                         ActiveColor="#FFC107"/>
                        <controls:StatusIndicatorControl Label="Fault" IsActive="{Binding AxisZFault}"
                                                         ActiveColor="#F44336"/>
                    </UniformGrid>

                    <TextBlock Text="{Binding AxisZErrorCode, StringFormat=Error: {0}}"
                               FontSize="12" Foreground="#B0B0B0" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="▼" FontSize="30" Height="60"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding JogZDownCommand}"/>

                        <Button Grid.Column="2" Content="▲" FontSize="30" Height="60"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding JogZUpCommand}"/>
                    </Grid>

                    <Button Content="🏠 HOME Z" Height="40" FontSize="14"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding HomeAxisZCommand}"/>
                </StackPanel>
            </Border>

            <!-- Right: Preset Positions & IO -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Preset Positions -->
                    <TextBlock Text="PRESET POSITIONS" FontSize="14" Foreground="#B0B0B0" Margin="0,0,0,8"/>

                    <Button Content="📍 Pick Position" Height="50" FontSize="16" Margin="0,0,0,8"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding MoveToPickCommand}"/>

                    <Button Content="📍 Place Position" Height="50" FontSize="16" Margin="0,0,0,8"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding MoveToPlaceCommand}"/>

                    <Button Content="🏠 Home Position" Height="50" FontSize="16" Margin="0,0,0,20"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding MoveToHomeCommand}"/>

                    <!-- IO Control -->
                    <TextBlock Text="IO CONTROL" FontSize="14" Foreground="#B0B0B0" Margin="0,0,0,8"/>

                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Vacuum" FontSize="16" VerticalAlignment="Center"/>

                            <controls:SwitchToggleControl Grid.Column="1"
                                                          Width="70"
                                                          Height="32"
                                                          IsChecked="{Binding VacuumOn}"
                                                          Command="{Binding ToggleVacuumCommand}"
                                                          OnLabel="ON"
                                                          OffLabel="OFF"/>
                        </Grid>
                    </Border>

                    <!-- JOG Speed -->
                    <TextBlock Text="JOG SPEED" FontSize="14" Foreground="#B0B0B0" Margin="0,12,0,8"/>

                    <ComboBox SelectedIndex="{Binding JogSpeedIndex}" Height="40" FontSize="14"
                              Background="#252526" Foreground="White" BorderBrush="#3E3E42">
                        <ComboBoxItem Content="🐌 Low (10 mm/s)"/>
                        <ComboBoxItem Content="🚶 Medium (50 mm/s)"/>
                        <ComboBoxItem Content="🏃 High (100 mm/s)"/>
                    </ComboBox>

                    <!-- Emergency Stop -->
                    <Button Content="⚠️ STOP ALL" Height="60" FontSize="18" Margin="0,20,0,0"
                            Style="{StaticResource ErrorButton}"
                            Command="{Binding StopAllAxesCommand}"/>

                    <!-- Test Image Dialog -->
                    <TextBlock Text="TEST DIALOGS" FontSize="14" Foreground="#B0B0B0" Margin="0,20,0,8"/>
                    <Button x:Name="TestImageDialogButton" Content="Test Image Dialog"
                            Height="50" FontSize="14" Margin="0,0,0,0"
                            Style="{StaticResource OutlineButton}"
                            Click="TestImageDialogButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
