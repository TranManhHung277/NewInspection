<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\NAutoSuite.Core\NAutoSuite.Core.csproj" />
    <ProjectReference Include="..\..\src\Hardware\NAutoSuite.Hardware.Simulator\NAutoSuite.Hardware.Simulator.csproj" />
    <ProjectReference Include="..\..\src\Hardware\NAutoSuite.Hardware.Leadshine\NAutoSuite.Hardware.Leadshine.csproj" />
    <ProjectReference Include="..\..\src\Hardware\NAutoSuite.Hardware.Keyence\NAutoSuite.Hardware.Keyence.csproj" />
    <ProjectReference Include="..\..\src\UI\NAutoSuite.UI.Infrastructure\NAutoSuite.UI.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\UI\NAutoSuite.UI.Themes\NAutoSuite.UI.Themes.csproj" />
    <ProjectReference Include="..\..\src\UI\NAutoSuite.UI.Controls\NAutoSuite.UI.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Configs\hardware_config.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>PickAndPlace</AssemblyName>
    <RootNamespace>PickAndPlace</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="GenerateEntityIds" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet run --project &quot;..\..\tools\EntityIdGenerator\EntityIdGenerator.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\Configs\hardware_config.yaml&quot; &quot;$(MSBuildProjectDirectory)\Generated\EntityIds.g.cs&quot;" />
  </Target>

</Project>
