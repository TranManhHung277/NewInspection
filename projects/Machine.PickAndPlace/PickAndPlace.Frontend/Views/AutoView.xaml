<UserControl x:Class="Machine.PickAndPlace.Views.AutoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1920">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Automatic Mode" FontSize="28" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,20"/>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Machine Status -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Production Status" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Cycle Count -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Cycles" FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CycleCount}" FontSize="24"
                                       FontWeight="Bold" Foreground="#2196F3"/>
                        </Grid>
                    </Border>

                    <!-- Run Time -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Run Time" FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding RunTime}" FontSize="20"
                                       Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Machine Animation -->
                    <Border Background="#1E1E1E" Height="300" CornerRadius="8" Margin="0,20,0,0">
                        <Grid>
                            <TextBlock Text="🤖" FontSize="120" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="Machine Visualization" FontSize="16"
                                       Foreground="#B0B0B0" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,140,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: Control Panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Control Panel" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Start Button -->
                    <Button Content="▶ START" Style="{StaticResource SuccessButton}"
                            Height="60" FontSize="18" Margin="0,0,0,12"
                            Command="{Binding StartCommand}"/>

                    <!-- Stop Button -->
                    <Button Content="⏹ STOP" Style="{StaticResource ErrorButton}"
                            Height="60" FontSize="18" Margin="0,0,0,12"
                            Command="{Binding StopCommand}"/>

                    <!-- Reset Button -->
                    <Button Content="🔄 RESET" Style="{StaticResource OutlineButton}"
                            Height="60" FontSize="18" Margin="0,0,0,20"
                            Command="{Binding ResetCommand}"/>

                    <!-- Home All Button -->
                    <Button Content="🏠 HOME ALL" Style="{StaticResource PrimaryButton}"
                            Height="50" FontSize="16"
                            Command="{Binding HomeAllCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
