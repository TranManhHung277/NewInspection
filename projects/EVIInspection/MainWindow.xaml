<Window x:Class="EVIInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
        xmlns:local="clr-namespace:EVIInspection" xmlns:viewmodels="clr-namespace:EVIInspection.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="EVI INSPECTION" Height="1080" Width="1920"
        WindowState="Maximized"
        WindowStyle="None">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <controls:ShellHeaderControl Grid.Row="0" x:Name="HeaderControl"
                                    MachineNumberValue="{Binding MachineNumber}"
                                    MachineState="{Binding MachineState}"
                                    ProjectNameValue="{Binding ProjectName}"
                                    ModelNameValue="{Binding ModelName}"
                                    RunModeValue="{Binding RunMode}"
                                    StatusLevel="{Binding HeaderStatusLevel}"
                                    HeaderClicked="HeaderControl_HeaderClicked"
                                    MinimizeClicked="HeaderControl_MinimizeClicked"
                                    CloseClicked="HeaderControl_CloseClicked"/>

        <!-- Content Area -->
        <Border Grid.Row="1" Background="#1E1E1E">
            <ContentControl x:Name="ContentArea" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding CurrentView}"/>
        </Border>

        <!-- Footer Navigation -->
        <controls:ShellFooterControl Grid.Row="2" x:Name="FooterControl"
                                     StartCommand ="{Binding StartCommand}" 
                                     StopCommand="{Binding StopCommand}" 
                                     ResetCommand="{Binding ResetCommand}"
                                     HomeHoldEndCommand="{Binding HomeHoldEndCommand}"
                                     HomeHoldStartCommand="{Binding HomeHoldStartCommand}"
                                     TabChanged="FooterControl_TabChanged"/>
    </Grid>
</Window>
