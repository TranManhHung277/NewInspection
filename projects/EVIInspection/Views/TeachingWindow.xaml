<Window x:Class="EVIInspection.Views.TeachingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EVIInspection.Views"
        xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
        mc:Ignorable="d"
        Background="Black"
        Title="TeachingWindow" Height="450" Width="800">
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="0.2*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" 
                BorderBrush="Red" 
                BorderThickness="2"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Margin="0,0,0,10">
                <Image x:Name="imgTeaching"
                       Source="{Binding PreviewImage}"
                       Stretch="Uniform">   
                </Image>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Viewbox  Grid.Column="0" Margin="10">
                <TextBlock Text="GaussianBlur"
                           Foreground="#FFFFFF" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="10,10,10,10"/>
            </Viewbox>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Slider Minimum="1" Maximum="31"
                        Value="{Binding BlurValue}" 
                        TickFrequency="2" 
                        IsSnapToTickEnabled="True"
                        Foreground="Black"  
                        FontSize="32" 
                        FontWeight="Bold"
                        VerticalContentAlignment="Center" 
                        HorizontalContentAlignment="Center">
                </Slider>
            </Grid>
            <Viewbox  Grid.Column="2" Margin="10">
                <TextBlock Text="Threshold" 
                           Foreground="#FFFFFF" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="10,10,10,10"/>   
            </Viewbox>
            <Grid Grid.Column="3" VerticalAlignment="Center">
                <Slider Minimum="0" Maximum="255"
                        Value="{Binding ThresholdValue}"
                        Foreground="Black"  
                        FontSize="32" 
                        FontWeight="Bold"
                        VerticalContentAlignment="Center" 
                        HorizontalContentAlignment="Center">
                </Slider>
            </Grid>




        </Grid>
    </Grid>
</Window>
