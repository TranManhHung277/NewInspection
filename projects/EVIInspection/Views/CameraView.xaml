    <UserControl 
             x:Class="EVIInspection.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Background="Black"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="FooterActionButtonStyle"></Style>
    </UserControl.Resources>    
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="0.9*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="4" 
                BorderBrush="Red" 
                BorderThickness="2"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Margin="0,0,0,10">
            <Grid>
                <Image x:Name="imgDisplay"
                       Source="{Binding ImageVM.MyImage}"
                       Stretch="Uniform">
                </Image>
                <Canvas x:Name="SelectionCanvas" Background="#01000000"
                        Width="{Binding ElementName=imgDisplay, Path=ActualWidth}"
                        Height="{Binding ElementName=imgDisplay, Path=ActualHeight}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDown">
                            <i:InvokeCommandAction Command="{Binding ImageVM.OnMouseDownCommand}" PassEventArgsToCommand="True" />
                        </i:EventTrigger>

                        <i:EventTrigger EventName="MouseMove">
                            <i:InvokeCommandAction Command="{Binding ImageVM.OnMouseMoveCommand}" PassEventArgsToCommand="True" />
                        </i:EventTrigger>

                        <i:EventTrigger EventName="MouseUp">
                            <i:InvokeCommandAction Command="{Binding ImageVM.OnMouseUpCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Rectangle Canvas.Left="{Binding ImageVM.RoiX}" 
                       Canvas.Top="{Binding ImageVM.RoiY}"
                       Width="{Binding ImageVM.RoiWidth}" 
                       Height="{Binding ImageVM.RoiHeight}"
                       Stroke="Yellow" StrokeThickness="2" IsHitTestVisible="False"
                       Visibility="{Binding ImageVM.IsSelecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        
                    </Rectangle>

                </Canvas>
            </Grid>
        </Border>

        <Viewbox Grid.Row="0" Grid.Column="0" Margin="10">
            <TextBlock Text="CAMERA" 
                       Foreground="#FFFFFF" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Margin="10,10,10,10"/>
        </Viewbox>

        <controls:ActionButton Grid.Row="1" 
                               Grid.Column="0"
                               Text="OPEN IMAGE"
                               Width="AUTO"
                               FontSize="20"
                               Height="AUTO"
                               FontWeight="Bold"
                               NormalBackground="#4CAF50"
                               HoverBackground="#42A5F5"
                               PressedBackground="#1976D2" 
                               BlinkBackground="#FFD54F"
                               IsBlinking="False"
                               ContentHorizontalAlignment="Center"
                               ContentVerticalAlignment="Center"
                               ClickCommand="{Binding ImageVM.ActionOpenImageCommand}"
                               Margin="5,5,5,5">

        </controls:ActionButton>
        <controls:ActionButton Grid.Column="0" 
                               Grid.Row="2"
                               Text="TRIGGER ON/OF"
                               Width="AUTO"
                               FontSize="20"
                               Height="AUTO"
                               FontWeight="Bold"
                               NormalBackground="#4CAF50"
                               HoverBackground="#42A5F5"
                               PressedBackground="#1976D2"
                               BlinkBackground="#FFD54F"
                               IsBlinking="False"
                               ContentHorizontalAlignment="Center"
                               ContentVerticalAlignment="Center"
                               Margin="5,5,5,5">
        </controls:ActionButton>
        <controls:ActionButton Grid.Column="0" Grid.Row="3"
                            Text="TEACHING"
                            Width="AUTO"
                            Height="AUTO"
                            FontSize="20"
                            FontWeight="Bold"
                            NormalBackground="#4CAF50"
                            HoverBackground="#42A5F5"
                            PressedBackground="#1976D2" 
                            BlinkBackground="#FFD54F"
                            IsBlinking="False"
                            ContentHorizontalAlignment="Center"
                            ContentVerticalAlignment="Center"
                            ClickCommand="{Binding ImageVM.TeachingCommand}"
                            Margin="5,5,5,5"/>      
        <controls:ActionButton Grid.Column="0" Grid.Row="4"
                               Text="PROCESS"
                                Width="AUTO"
                                Height="AUTO"
                                FontSize="20" 
                                FontWeight="Bold"
                                NormalBackground="#4CAF50"
                                HoverBackground="#42A5F5"
                                PressedBackground="#1976D2" 
                                BlinkBackground="#FFD54F"
                                IsBlinking="False"
                                ContentHorizontalAlignment="Center"
                                ContentVerticalAlignment="Center"
                                ClickCommand="{Binding ImageVM.ProcessCommand}"
                               Margin="5,5,5,5"/>
        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Background="Blue">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Tiêu đề -->
                <RowDefinition Height="*"/>
                <!-- Danh sách kết quả -->
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <!-- Score -->
                    <ColumnDefinition Width="1*"/>
                    <!-- X -->
                    <ColumnDefinition Width="1*"/>
                    <!-- Y -->
                    <ColumnDefinition Width="1*"/>
                    <!-- R -->
                </Grid.ColumnDefinitions>
                <TextBlock Text="SCORE" Foreground="Yellow" FontSize="20" FontWeight="Bold" Grid.Column="0" HorizontalAlignment="Center"/>
                <TextBlock Text="X" Foreground="White" FontSize="20" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Center"/>
                <TextBlock Text="Y" Foreground="White" FontSize="20" FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Center"/>
                <TextBlock Text="Angle" Foreground="White" FontSize="20" FontWeight="Bold" Grid.Column="3" HorizontalAlignment="Center"/>
            </Grid>
            <!--<Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>-->
            <!--<TextBlock Text="RESULT" Grid.Column="0" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10"/>
            <TextBlock Text="X:" Grid.Column="1" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10"/>
            <TextBox Grid.Column="2" Text="{Binding ImageVM.ResultX}" Foreground="Black"  FontSize="32" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock Text="Y:" Grid.Column="3" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10"/>
            <TextBox  Foreground="Black" Text="{Binding ImageVM.ResultY}" Grid.Column="4" FontSize="32" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock Text="R:" Grid.Column="5" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10"/>
            <TextBox  Foreground="Black" Text="{Binding ImageVM.ResultR}"  Grid.Column="6" FontSize="32" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>-->
            <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ImageVM.ListResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="White" BorderThickness="0,0,0,1" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Hiển thị Score (Độ khớp) -->
                                    <TextBlock Text="{Binding ResultScore, StringFormat=F3}" Foreground="Yellow" FontSize="24" FontWeight="Bold" Grid.Column="0" HorizontalAlignment="Center"/>

                                    <!-- Hiển thị Tọa độ X -->
                                    <TextBlock Text="{Binding ResultX}" Foreground="White" FontSize="24" Grid.Column="1" HorizontalAlignment="Center"/>

                                    <!-- Hiển thị Tọa độ Y -->
                                    <TextBlock Text="{Binding ResultY}" Foreground="White" FontSize="24" Grid.Column="2" HorizontalAlignment="Center"/>

                                    <!-- Hiển thị Góc xoay R -->
                                    <TextBlock Text="{Binding ResultR}" Foreground="White" FontSize="24" Grid.Column="3" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
        </Grid>
    </Grid>
</UserControl>
