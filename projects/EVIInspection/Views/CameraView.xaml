<UserControl x:Class="EVIInspection.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             Background="Red"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="FooterActionButtonStyle"></Style>
    </UserControl.Resources>
    <Grid Background="Red">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.7*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image x:Name="imgDisplay" Source="{Binding ImageVM.MyImage}" 
               Grid.Row="1"  Grid.Column="1" Grid.RowSpan="4" Stretch="Uniform" Margin="0,0,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Canvas x:Name="SelectionCanvas" 
            Background="Transparent"
            MouseDown="{Binding ImageVM.OnMouseDownCommand}"
            MouseMove="{Binding ImageVM.OnMouseMoveCommand}"
            MouseUp="{Binding ImageVM.OnMouseUpCommand}">

            <Rectangle Canvas.Left="{Binding ImageVM.RoiX}" 
                   Canvas.Top="{Binding ImageVM.RoiY}"
                   Width="{Binding ImageVM.RoiWidth}" 
                   Height="{Binding ImageVM.RoiHeight}"
                   Stroke="Yellow" StrokeThickness="2" StrokeDashArray="4 2"
                   Visibility="{Binding ImageVM.IsSelecting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Canvas>

        <TextBlock Text="CAMERA"
                   Grid.Row="0" 
                   Grid.Column="0"
                   Foreground="#FFFFFF"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="10,10,10,10"/>
        <controls:ActionButton
            Grid.Column="0" Grid.Row="1"
    Text="OPEN IMAGE"
    Width="AUTO"
    Height="AUTO"
    FontSize="32"
    FontWeight="Bold"
    NormalBackground="#2196F3"
    HoverBackground="#42A5F5"
    PressedBackground="#1976D2" 
    BlinkBackground="#FFD54F"
    IsBlinking="False"
    ContentHorizontalAlignment="Center"
    ContentVerticalAlignment="Center"
    ClickCommand="{Binding ImageVM.ActionOpenImageCommand}"/>
        <Button Grid.Row="2" 
                Grid.Column="0" 
                Content="TRIGGER" 
                
                FontSize="32" 
                FontWeight="Bold"
                Command="{Binding StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                Background="#4CAF50" 
                Foreground="#FFFFFF" 
                Padding="12,6" 
                Margin="10,10,10,10" Style="{StaticResource FooterActionButtonStyle}" />
        <controls:ActionButton
        Grid.Column="0" Grid.Row="3"
Text="TEACHING"
Width="AUTO"
Height="AUTO"
FontSize="32"
FontWeight="Bold"
NormalBackground="#2196F3"
HoverBackground="#42A5F5"
PressedBackground="#1976D2" 
BlinkBackground="#FFD54F"
IsBlinking="False"
ContentHorizontalAlignment="Center"
ContentVerticalAlignment="Center"
ClickCommand="{Binding ImageVM.TeachingCommand}"/>
        <controls:ActionButton
        Grid.Column="0" Grid.Row="4"
Text="PROCESS"
Width="AUTO"
Height="AUTO"
FontSize="32"
FontWeight="Bold"
NormalBackground="#2196F3"
HoverBackground="#42A5F5"
PressedBackground="#1976D2" 
BlinkBackground="#FFD54F"
IsBlinking="False"
ContentHorizontalAlignment="Center"
ContentVerticalAlignment="Center"
ClickCommand="{Binding ImageVM.ProcessCommand}"/>
        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Background="Blue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="RESULT:" Grid.Column="0" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10"/>
            <TextBlock Text="X:" Grid.Column="1" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10"/>
            <TextBox Grid.Column="2"  Foreground="Black"  FontSize="32" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock Text="Y:" Grid.Column="3" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10"/>
            <TextBox  Foreground="Black"  Grid.Column="4" FontSize="32" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock Text="R:" Grid.Column="5" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10"/>
            <TextBox  Foreground="Black"   Grid.Column="6" FontSize="32" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        </Grid>
    </Grid>
</UserControl>
