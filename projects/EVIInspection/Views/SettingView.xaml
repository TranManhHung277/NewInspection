<UserControl x:Class="EVIInspection.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EVIInspection.Views"
             xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="SETTING" FontSize="22" FontWeight="Bold"
               Foreground="White" Margin="0,0,0,12"/>

        <!-- Content -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                
                <controls:InputField x:Name="MachineNumberInput"
                                     Value="{Binding MachineNumber}"
                                     MaxValue="100"
                                     MinValue="40"
                                        InputHeight="100"
                                        InputFontSize="20"
                                        HorizontalTextAlignment="Center"
                                        Padding="0,10"
                                        ValueType="Int32"
                                        KeyboardType="Numeric"
                                        AllowDecimal="False"
                                        ShowKeyboardButton="True"/>
                <TextBlock Foreground="#E53935"
                           FontSize="14"
                           Margin="4,6,0,0"
                           Text="{Binding ValidationErrorMessage, ElementName=MachineNumberInput}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid, ElementName=MachineNumberInput}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <controls:InputField Value="{Binding MachineNumber}"
                                        Padding="0,10"
                                        IsEnabled="False"
                                        ValueType="Int32"
                                        KeyboardType="Numeric"
                                        AllowDecimal="False"
                                        ShowKeyboardButton="True"/>
                <controls:DisplayField Value="{Binding MachineNumber}"
                                       Padding="0,10"
                                       InputHeight="100"
                                       InputFontSize="100"
                                       HorizontalTextAlignment="Center"
                                       InputFontWeight="Bold"
                       ValueType="Int32"
                       DisplayDecimals="2"/>
                <controls:DisplayField Value="{Binding MachineNumber}" 
                       ValueType="Int32"
                       ColorZoneTarget="Border"
                                       InputFontWeight="Bold"
                       Threshold1="10" Threshold2="25" Threshold3="35"
                       ZoneColor1="Blue" ZoneColor2="Green" 
                       ZoneColor3="Orange" ZoneColor4="Red"/>

            </StackPanel>
               

                           

        </Grid>
    </Grid>
</UserControl>
