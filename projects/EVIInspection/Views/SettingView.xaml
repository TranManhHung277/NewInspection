<UserControl x:Class="EVIInspection.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EVIInspection.Views"
             xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DrawingImage x:Key="ApplyIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M3,10 L8,15 L21,2 L23,4 L8,19 L1,12 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="SETTING" FontSize="22" FontWeight="Bold"
               Foreground="White" Margin="0,0,0,12"/>

        <!-- Content -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                
                <controls:InputField x:Name="MachineNumberInput"
                                     Value="{Binding MachineNumber}"
                                     MaxValue="99"
                                     MinValue="0"
                                        InputHeight="100"
                                        InputFontSize="20"
                                        HorizontalTextAlignment="Center"
                                        Padding="0,10"
                                        ValueType="Int32"
                                        KeyboardType="Numeric"
                                        AllowDecimal="False"
                                        ShowKeyboardButton="True"/>
                <TextBlock Foreground="#E53935"
                           FontSize="14"
                           Margin="4,6,0,0"
                           Text="{Binding ValidationErrorMessage, ElementName=MachineNumberInput}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid, ElementName=MachineNumberInput}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <controls:ActionButton
                    Text="APPLY"
                    Margin="0,16,0,0"
                    Width="220"
                    Height="64"
                    FontSize="22"
                    FontWeight="Bold"
                    NormalBackground="#2196F3"
                    HoverBackground="#42A5F5"
                    PressedBackground="#1976D2"
                    BlinkBackground="#FFD54F"
                    IsBlinking="False"
                    ContentHorizontalAlignment="Center"
                    ContentVerticalAlignment="Center"
                    ClickCommand="{Binding StartCommand}"/>

                <controls:ActionButton
                    Text="APPLY WITH ICON"
                    Margin="0,12,0,0"
                    Width="300"
                    Height="64"
                    FontSize="20"
                    FontWeight="Bold"
                    NormalBackground="#455A64"
                    HoverBackground="#546E7A"
                    PressedBackground="#37474F"
                    Icon="{StaticResource ApplyIcon}"
                    IconPosition="Left"
                    IconSize="22"
                    ClickCommand="{Binding ResetCommand}"/>


            </StackPanel>
               

                           

        </Grid>
    </Grid>
</UserControl>
