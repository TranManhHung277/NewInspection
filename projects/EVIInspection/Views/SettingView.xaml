<UserControl x:Class="EVIInspection.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EVIInspection.Views"
             xmlns:controls="clr-namespace:NAutoSuite.UI.Controls;assembly=NAutoSuite.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" Height="572">
    <UserControl.Resources>
        <DrawingImage x:Key="ApplyIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M3,10 L8,15 L21,2 L23,4 L8,19 L1,12 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="SETTING" FontSize="22" FontWeight="Bold"
               Foreground="White" Margin="0,0,0,12"/>
        <TextBox Grid.Row="1" 
                 Grid.Column="1" 
                 Height="150" 
                 Text="{Binding ProjectName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"></TextBox>
        <!-- Content -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">

                <controls:InputField x:Name="MachineNumberInput"
                                     Value="{Binding MachineNumber}"
                                     MaxValue="99"
                                     MinValue="0"
                                        InputHeight="100"
                                        InputFontSize="20"
                                        HorizontalTextAlignment="Center"
                                        Padding="0,10"
                                        ValueType="Int32"
                                        KeyboardType="Numeric"
                                        AllowDecimal="False"
                                        ShowKeyboardButton="True"></controls:InputField>

                <TextBlock Foreground="#E53935"
                           FontSize="14"
                           Margin="4,6,0,0"
                           Text="{Binding ValidationErrorMessage, ElementName=MachineNumberInput}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid, ElementName=MachineNumberInput}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <controls:ActionButton
                    Text="APPLY"
                    Margin="0,16,0,0"
                    Width="220"
                    Height="64"
                    FontSize="22"
                    FontWeight="Bold"
                    NormalBackground="#2196F3"
                    HoverBackground="#42A5F5"
                    PressedBackground="#1976D2"
                    BlinkBackground="#FFD54F"
                    IsBlinking="False"
                    ContentHorizontalAlignment="Center"
                    ContentVerticalAlignment="Center"
                    ClickCommand="{Binding StartCommand}"/>

                <controls:ActionButton
                    Text="APPLY WITH ICON"
                    Margin="0,12,0,0"
                    Width="300"
                    Height="64"
                    FontSize="20"
                    FontWeight="Bold"
                    NormalBackground="#455A64"
                    HoverBackground="#546E7A"
                    PressedBackground="#37474F"
                    Icon="{StaticResource ApplyIcon}"
                    IconPosition="Left"
                    IconSize="22"
                    ClickCommand="{Binding ResetCommand}"/>

                <controls:ActionButton
                    Text="AUTO MODE"
                    CheckedText="MANUAL MODE"
                    Margin="0,12,0,0"
                    Width="260"
                    Height="64"
                    FontSize="20"
                    FontWeight="Bold"
                    IsToggle="True"
                    NormalBackground="#5D4037"
                    HoverBackground="#6D4C41"
                    PressedBackground="#4E342E"
                    CheckedBackground="#2E7D32"/>

                <controls:ActionButton
                    Text="HOLD 1.5S"
                    Margin="0,12,0,0"
                    Width="260"
                    Height="64"
                    FontSize="20"
                    FontWeight="Bold"
                    NormalBackground="#6A1B9A"
                    HoverBackground="#7B1FA2"
                    PressedBackground="#4A148C"
                    HoldDelayMs="1500"
                    HoldCommand="{Binding HomeHoldStartCommand}"
                    HoldCompletedCommand="{Binding HomeHoldEndCommand}"/>
                <controls:ActionButton
                    Text="NEW BUTTON"
                    Margin="0,12,0,0"
                    Width="300"
                    Height="64"
                    FontSize="20"
                    FontWeight="Bold"
                    NormalBackground="#455A64"
                    HoverBackground="#546E7A"
                    PressedBackground="#37474F"
                   
                    IconPosition="Left"
                    IconSize="22"
                    />


            </StackPanel>




        </Grid>
    </Grid>
</UserControl>
