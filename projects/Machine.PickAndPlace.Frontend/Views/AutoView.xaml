<UserControl x:Class="Machine.PickAndPlace.Views.AutoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1920">

    <UserControl.Resources>
        <!-- Blinking Animation for Tower Lights -->
        <Storyboard x:Key="BlinkingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="1.0" To="0.2" Duration="0:0:0.5"
                           AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Automatic Mode - EtherCAT Control" FontSize="28" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,20"/>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Machine Status & Axis Info -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Machine State & Status -->
                    <TextBlock Text="Machine Status" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Status Message -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status: " FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="16"
                                       Foreground="White" TextWrapping="Wrap" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Cycle Count -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Cycles" FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CycleCount}" FontSize="24"
                                       FontWeight="Bold" Foreground="#2196F3"/>
                        </Grid>
                    </Border>

                    <!-- Run Time -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Run Time" FontSize="16" Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="1" Text="{Binding RunTime}" FontSize="20"
                                       Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Axis Position -->
                    <Border Background="#252526" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Axis Position" FontSize="16" Foreground="#B0B0B0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding AxisPosition, StringFormat='{}{0:F2}'}" FontSize="20"
                                           Foreground="#4CAF50" FontWeight="Bold"/>
                                <TextBlock Text=" mm" FontSize="16" Foreground="#B0B0B0" Margin="5,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tower Lights Visualization -->
                    <Border Background="#1E1E1E" Padding="20" CornerRadius="8" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Tower Lights" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,16" HorizontalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Red Light -->
                                <Border Width="60" Height="60" CornerRadius="30" Margin="10"
                                        Background="{Binding TowerLightRed, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Red'}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MachineState}" Value="EmergencyStop">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Storyboard="{StaticResource BlinkingAnimation}"/>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MachineState}" Value="Error">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Storyboard="{StaticResource BlinkingAnimation}"/>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="RED" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>

                                <!-- Yellow Light -->
                                <Border Width="60" Height="60" CornerRadius="30" Margin="10"
                                        Background="{Binding TowerLightYellow, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Yellow'}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MachineState}" Value="Initializing">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Storyboard="{StaticResource BlinkingAnimation}"/>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="YELLOW" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="Black"/>
                                </Border>

                                <!-- Green Light -->
                                <Border Width="60" Height="60" CornerRadius="30" Margin="10"
                                        Background="{Binding TowerLightGreen, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green'}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MachineState}" Value="Paused">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Storyboard="{StaticResource BlinkingAnimation}"/>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="GREEN" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- Buzzer Indicator -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Ellipse Width="20" Height="20" Margin="5">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding Buzzer, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Orange'}"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Buzzer}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                               From="1.0" To="0.0" Duration="0:0:0.25"
                                                                               AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="BUZZER" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{Binding Buzzer, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Orange'}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: Control Panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Control Panel" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Initialize Button -->
                    <Button Content="⚙ INITIALIZE" Style="{StaticResource PrimaryButton}"
                            Height="60" FontSize="18" Margin="0,0,0,12"
                            Command="{Binding InitializeCommand}"/>

                    <!-- Home Button -->
                    <Button Content="🏠 HOME AXIS" Style="{StaticResource PrimaryButton}"
                            Height="60" FontSize="18" Margin="0,0,0,20"
                            Command="{Binding HomeAllCommand}"/>

                    <!-- Start Button -->
                    <Button Content="▶ START" Style="{StaticResource SuccessButton}"
                            Height="70" FontSize="20" Margin="0,0,0,12"
                            Command="{Binding StartCommand}" FontWeight="Bold"/>

                    <!-- Stop Button -->
                    <Button Content="⏹ STOP" Style="{StaticResource ErrorButton}"
                            Height="70" FontSize="20" Margin="0,0,0,12"
                            Command="{Binding StopCommand}" FontWeight="Bold"/>

                    <!-- Emergency Stop Button -->
                    <Button Content="🛑 EMERGENCY STOP" Background="#D32F2F" Foreground="White"
                            Height="70" FontSize="18" Margin="0,0,0,20" FontWeight="Bold"
                            Command="{Binding EmergencyStopCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="#FF5252" BorderThickness="3"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B71C1C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Reset Button -->
                    <Button Content="🔄 RESET" Style="{StaticResource OutlineButton}"
                            Height="50" FontSize="16"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
